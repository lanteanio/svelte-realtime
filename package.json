{
  "name": "svelte-realtime",
  "version": "0.6.0-next.8",
  "publishConfig": {
    "tag": "next"
  },
  "description": "Realtime RPC and reactive subscriptions for SvelteKit, built on svelte-adapter-uws",
  "author": "Kevin Radziszewski",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lanteanio/svelte-realtime.git"
  },
  "homepage": "https://github.com/lanteanio/svelte-realtime",
  "bugs": "https://github.com/lanteanio/svelte-realtime/issues",
  "type": "module",
  "bin": {
    "svelte-realtime": "./cli.js"
  },
  "exports": {
    ".": {
      "types": "./server.d.ts",
      "default": "./server.js"
    },
    "./server": {
      "types": "./server.d.ts",
      "default": "./server.js"
    },
    "./client": {
      "types": "./client.d.ts",
      "default": "./client.js"
    },
    "./multiplayer": {
      "types": "./client-multiplayer.d.ts",
      "default": "./client-multiplayer.svelte.js"
    },
    "./smooth": {
      "types": "./client-smooth.d.ts",
      "default": "./client-smooth.svelte.js"
    },
    "./vite": {
      "types": "./vite.d.ts",
      "default": "./vite.js"
    },
    "./devtools": {
      "types": "./devtools.d.ts",
      "default": "./devtools.js"
    },
    "./test": {
      "types": "./test.d.ts",
      "default": "./test.js"
    },
    "./test-client": {
      "types": "./test-client.d.ts",
      "default": "./test-client.js"
    },
    "./hooks": {
      "types": "./hooks.d.ts",
      "default": "./hooks.js"
    }
  },
  "files": [
    "server.js",
    "server.d.ts",
    "client.js",
    "client.d.ts",
    "client-runtime.js",
    "client-multiplayer.svelte.js",
    "client-multiplayer.d.ts",
    "client-smooth.svelte.js",
    "client-smooth.d.ts",
    "vite.js",
    "vite.d.ts",
    "test.js",
    "test.d.ts",
    "test-client.js",
    "test-client.d.ts",
    "devtools.js",
    "devtools.d.ts",
    "hooks.js",
    "hooks.d.ts",
    "cli.js",
    "cli-utils.js",
    "shared",
    "LICENSE",
    "README.md",
    "MIGRATION.md"
  ],
  "scripts": {
    "check": "node scripts/check-determinism.js",
    "pretest": "npm run check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --config test/e2e/playwright.config.js",
    "test:chaos": "playwright test --config test/chaos/playwright.config.js",
    "test:fuzz": "node test/fuzz-wire.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@clack/prompts": "^0.10.1"
  },
  "peerDependencies": {
    "@sveltejs/kit": "^2.0.0",
    "svelte": "^4.0.0 || ^5.0.0",
    "svelte-adapter-uws": "^0.6.0-next.24"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "fast-check": "^4.7.0",
    "svelte-adapter-uws-extensions": "^0.5.3",
    "vitest": "^4.0.18"
  },
  "keywords": [
    "svelte",
    "sveltekit",
    "websocket",
    "rpc",
    "realtime",
    "pubsub",
    "uwebsockets",
    "streams",
    "live"
  ]
}
