{
  "name": "svelte-realtime",
  "version": "0.6.0-next.91",
  "publishConfig": {
    "tag": "next"
  },
  "description": "Realtime RPC and reactive subscriptions for SvelteKit, built on svelte-adapter-uws",
  "author": "Kevin Radziszewski",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanteanio/svelte-realtime.git"
  },
  "homepage": "https://svelte-realtime.dev/",
  "bugs": {
    "url": "https://github.com/lanteanio/svelte-realtime/issues"
  },
  "type": "module",
  "bin": {
    "svelte-realtime": "./src/cli.js"
  },
  "exports": {
    ".": {
      "types": "./src/server.d.ts",
      "default": "./src/server.js"
    },
    "./server": {
      "types": "./src/server.d.ts",
      "default": "./src/server.js"
    },
    "./client": {
      "types": "./src/client.d.ts",
      "default": "./src/client.js"
    },
    "./multiplayer": {
      "types": "./src/client-multiplayer.d.ts",
      "default": "./src/client-multiplayer.svelte.js"
    },
    "./smooth": {
      "types": "./src/client-smooth.d.ts",
      "default": "./src/client-smooth.svelte.js"
    },
    "./doc": {
      "types": "./src/client-doc.d.ts",
      "default": "./src/client-doc.svelte.js"
    },
    "./rooms": {
      "types": "./src/client-rooms.d.ts",
      "default": "./src/client-rooms.svelte.js"
    },
    "./vite": {
      "types": "./src/vite.d.ts",
      "default": "./src/vite.js"
    },
    "./devtools": {
      "types": "./src/devtools.d.ts",
      "default": "./src/devtools.js"
    },
    "./testing": {
      "types": "./src/testing.d.ts",
      "default": "./src/testing.js"
    },
    "./testing/client": {
      "types": "./src/testing-client.d.ts",
      "default": "./src/testing-client.js"
    },
    "./hooks": {
      "types": "./src/hooks.d.ts",
      "default": "./src/hooks.js"
    },
    "./sim": {
      "types": "./src/sim.d.ts",
      "default": "./src/sim.js"
    }
  },
  "files": [
    "src",
    "docs",
    "LICENSE",
    "README.md",
    "MIGRATION.md",
    "protocol.schema.json"
  ],
  "scripts": {
    "check": "node scripts/generate-error-reference.js --check && node scripts/generate-onboarding-reference.js && node scripts/check-types.js && node scripts/check-diagnostic-attribution.js && node scripts/check-publish-routing.js && node scripts/check-determinism.js && node scripts/check-slugs.js && node --no-warnings --experimental-vm-modules scripts/check-syntax.js && node scripts/check-scaffold-build.js && npm run check:format && npm run check:publish && npm run check:verification && npm run check:links && npm run check:examples && npm run check:documentation",
    "check:errors": "node scripts/generate-error-reference.js --check",
    "generate:errors": "node scripts/generate-error-reference.js --write",
    "generate:onboarding": "node scripts/generate-onboarding-reference.js --write --sync-docs-site",
    "pretest": "npm run check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:devtools": "vitest run --config vitest.devtools.config.js",
    "test:e2e": "playwright test --config test/e2e/playwright.config.js",
    "test:chaos": "playwright test --config test/chaos/playwright.config.js",
    "test:fuzz": "node test/fuzz-wire.mjs",
    "sim:golden": "node scripts/sim-golden.js",
    "check:format": "node scripts/check-formatting.js",
    "check:publish": "publint && attw --pack . --profile esm-only",
    "check:verification": "node scripts/check-verification-inventory.js",
    "generate:verification": "node scripts/check-verification-inventory.js --write",
    "verify:fast": "npm run check",
    "verify:docs": "npm run check:format && npm run check:errors && node scripts/generate-onboarding-reference.js && npm run check:links && npm run check:examples && npm run test:examples && npm run check:documentation",
    "verify:unit": "npm test",
    "verify:sim": "npm run sim:golden && npm run test:fuzz",
    "verify:devtools": "npm run test:devtools",
    "verify:browser": "npm run test:e2e",
    "verify:chaos": "npm run test:chaos",
    "verify:pr": "npm run verify:unit && npm run verify:sim && npm run verify:devtools && npm run verify:scaffold",
    "verify:full": "npm run verify:pr && npm run verify:browser && npm run verify:chaos",
    "smoke": "node scripts/smoke.js",
    "check:links": "node scripts/check-links.js",
    "check:links:external": "node scripts/check-external-links.js",
    "check:examples": "node scripts/check-doc-code.js",
    "generate:examples": "node scripts/check-doc-code.js --write",
    "test:examples": "vitest run test/documentation-code.test.js test/packed-readme-examples.test.js",
    "check:documentation": "node scripts/check-documentation-contract.js",
    "generate:documentation": "node scripts/check-documentation-contract.js --write",
    "test:scaffold": "vitest run --config vitest.scaffold.config.js",
    "verify:scaffold": "npm run test:scaffold",
    "test:chaos:parallel": "node scripts/check-chaos-isolation.js",
    "test:lifecycle": "node scripts/check-production-lifecycle.js",
    "test:smooth-stack": "node scripts/check-smooth-stack.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@babel/parser": "^7.29.9",
    "@clack/prompts": "^1.8.1"
  },
  "peerDependencies": {
    "@sveltejs/kit": "^2.0.0",
    "svelte": "^4.0.0 || ^5.0.0",
    "svelte-adapter-uws": "^0.6.0-next.95"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@playwright/test": "^1.59.1",
    "acorn": "^8.16.0",
    "fast-check": "^4.7.0",
    "github-slugger": "^2.0.0",
    "markdown-it": "^15.0.0",
    "parse5": "^8.0.0",
    "publint": "^0.3.22",
    "svelte-adapter-uws-extensions": "^0.6.0-next.63",
    "typescript": "^6.0.3",
    "vitest": "^4.0.18",
    "yaml": "^2.9.0",
    "@axe-core/playwright": "^4.13.0"
  },
  "overrides": {
    "cookie": "^0.7.2"
  },
  "keywords": [
    "svelte",
    "sveltekit",
    "websocket",
    "rpc",
    "realtime",
    "pubsub",
    "uwebsockets",
    "streams",
    "live"
  ]
}
